# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Force LF line endings for all text files (prevents CRLF noise on Windows)
* text=auto eol=lf

# Mark the database schema as having been generated.
db/schema.rb linguist-generated
schema.json linguist-generated
schema.graphql linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored

# Ensure shell scripts always use LF line endings (critical for Docker containers)
*.sh text eol=lf
bin/* text eol=lf
Dockerfile* text eol=lf
